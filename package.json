{
  "name": "vivin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:segments": "node --experimental-strip-types --test tests/markdown-segments.test.mjs",
    "test:outline": "node --experimental-strip-types --test tests/markdown-outline.test.mjs",
    "test:markdown": "node --experimental-strip-types --test tests/markdown-*.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs tests/recent-projects.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lucide/vue": "^1.61.0",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "@milkdown/vue": "^7.22.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-log": "^2.10.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "codemirror": "^6.0.2",
    "decode-named-character-reference": "^1.3.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.6",
    "katex": "^0.16.47",
    "mermaid": "^12.2.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "11.0.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.11.0"
}
